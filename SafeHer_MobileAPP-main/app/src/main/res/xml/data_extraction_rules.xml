<?xml version="1.0" encoding="utf-8"?>
<!--
   SafeHer Privacy Configuration
   Disables all cloud backups and device transfers to protect user privacy.
   Emergency contacts are sensitive data and should remain on device only.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- Disable cloud backup for all data -->
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>

    <device-transfer>
        <!-- Disable device-to-device transfer -->
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>