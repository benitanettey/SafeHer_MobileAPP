<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".SettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_back"
                app:tint="@color/purple_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Settings"
                android:textColor="@color/purple_primary"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Your Wellness Profile -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/wellnessProfileCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/purple_light_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/purple_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Wellness Profile"
                        android:textColor="@color/purple_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Update your preferences"
                        android:textColor="@color/purple_accent"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/purple_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Daily Check-in -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="#F0F0F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_favorite"
                    android:drawablePadding="8dp"
                    android:text="Daily Check-in"
                    android:textColor="@color/purple_primary"
                    android:textSize="16sp"
                    app:tint="@color/purple_primary" />

                <Switch
                    android:id="@+id/dailyRemindersSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Daily Reminders"
                    android:textColor="@color/purple_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Get reminded to check in daily"
                    android:textColor="@color/purple_accent"
                    android:textSize="12sp" />


                <TextView
                    android:id="@+id/preferredTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/edittext_background"
                    android:padding="12dp"
                    android:text="09:00 AM"
                    android:textColor="@color/purple_primary" />

                <Switch
                    android:id="@+id/quickAccessSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Quick Access"
                    android:textColor="@color/purple_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable quick wellness shortcuts"
                    android:textColor="@color/purple_accent"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Privacy & Security -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="#F0F0F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_security"
                    android:drawablePadding="8dp"
                    android:text="Privacy &amp; Security"
                    android:textColor="@color/purple_primary"
                    android:textSize="16sp"
                    app:tint="@color/purple_primary" />

                <TextView
                    android:id="@+id/appLockSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawableEnd="@drawable/ic_arrow_forward"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:text="App Lock Settings"
                    android:textColor="@color/purple_primary"
                    app:tint="@color/purple_primary" />

                <TextView
                    android:id="@+id/alertHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:drawableStart="@drawable/ic_history"
                    android:drawableEnd="@drawable/ic_arrow_forward"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:text="Alert History"
                    android:textColor="@color/purple_primary"
                    app:tint="@color/purple_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- About -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="#F0F0F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/about"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_arrow_forward"
                    android:gravity="center_vertical"
                    android:text="About SafeHer"
                    android:textColor="@color/purple_primary"
                    app:tint="@color/purple_primary" />

                <TextView
                    android:id="@+id/privacyPolicy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:drawableEnd="@drawable/ic_arrow_forward"
                    android:gravity="center_vertical"
                    android:text="Privacy Policy"
                    android:textColor="@color/purple_primary"
                    app:tint="@color/purple_primary" />

                <TextView
                    android:id="@+id/helpAndSupport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:drawableEnd="@drawable/ic_arrow_forward"
                    android:gravity="center_vertical"
                    android:text="Help &amp; Support"
                    android:textColor="@color/purple_primary"
                    app:tint="@color/purple_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:text="SafeHer v1.0.0"
            android:textColor="@color/purple_accent"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
